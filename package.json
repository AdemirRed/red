{
  "name": "cloudshare-upload-system",
  "version": "2.0.0",
  "description": "Sistema de upload e download de arquivos com autenticação e separação por usuário",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "frontend": "cd frontend && npm run dev",
    "start:all": "start /B npm start && cd frontend && npm run dev",
    "dev:all": "start /B npm run dev && cd frontend && npm run dev",
    "setup-db": "node setup-database.js",
    "migrate": "node migrations.js run",
    "migrate:create": "node migrations.js create",
    "db:recreate": "node recreate-db.js",
    "reset-password": "node reset_password.js"
  },
  "keywords": [
    "upload",
    "download",
    "files",
    "cloudshare",
    "authentication",
    "postgresql"
  ],
  "author": "CloudShare System",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "chokidar": "^4.0.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.1.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "node-pg-migrate": "^8.0.3",
    "nodemailer": "^8.0.1",
    "path": "^0.12.7",
    "pg": "^8.11.3",
    "react-toastify": "^11.0.5",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
